# Build context is the project root (see reactor_app/build.sh). Keep the
# context small: exclude generated/large files we don't need in the image.

# Python cruft
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local venvs
.venv/
venv/

# Source control
.git/
.gitignore

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Frontend (separate dev loop, not needed in the runtime image)
frontend/node_modules/
frontend/.next/

# Large local artifacts — weights are mounted at runtime, not baked in
checkpoints/
assets/
eval_outputs/
*.tar.gz
*.zip

# Old reactor scaffold (to be deleted post-migration)
reactor_code/

# Docs scratch
reactor-docs*.txt

# --- CoinRun runner image (Dockerfile) ---
# The runner image copies only pyproject.toml, uv.lock, README.md,
# dreamer/data/generate_coinrun_dataset.py and scripts/coinrun_runner.py. Every
# scientific input is read from the runtime Git checkout, so nothing else may
# enter the build context. Datasets and credentials must never be baked in.
site/
datasets/
artifacts/
results/
logs/
outputs/
wandb/
*.array_record
*.npz
*.mp4
*.ckpt
.runpod/

